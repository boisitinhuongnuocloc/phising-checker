{
  "manifest_version": 3,
  "name": "ScamGuard - Anti Scam Checker",
  "description": "Rule-based phishing and scam checker for suspicious links, messages, and web pages. Runs locally in your browser.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with ScamGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scanner.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options.html"
}
